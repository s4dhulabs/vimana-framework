# This file is part of Vimana Framework Project.

echo "🚀 Setting up Vimana Framework with uv..."

# Check if uv is installed
if ! command -v uv &> /dev/null; then
    echo "📦 Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    source ~/.bashrc
fi

# Create virtual environment and install dependencies
echo "🔧 Creating virtual environment..."
uv sync

# Create symlinks
echo "🔗 Creating symlinks..."
sudo ln -sf $PWD/vimana.py /usr/bin/vimana
sudo ln -sf $PWD/vimana.py /usr/bin/vf

echo "✅ Vimana Framework setup complete!"
echo "🎯 Run 'vimana' or 'vf' to start the framework"
echo "🌐 Virtual environment: .venv (in project directory)"
echo "💡 Use 'uv run python -m vimana' to run with proper environment"

# Activate the virtual environment in the current shell
echo "🔧 Activating virtual environment..."
export VIRTUAL_ENV_DISABLE_PROMPT=1
source .venv/bin/activate

# Set custom prompt for the virtual environment
export PS1="(vimana-framework) > "

echo "🎉 Virtual environment activated! You can now use:"
echo "   - vimana (or vf) - to run the framework"
echo "   - python -m vimana - alternative way to run"
echo "   - deactivate - to exit the virtual environment"

# Start Vimana using the activated environment
vimana 
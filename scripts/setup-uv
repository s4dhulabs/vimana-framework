# This file is part of Vimana Framework Project.

echo "🚀 Setting up Vimana Framework with uv..."

# Check if uv is installed
if ! command -v uv &> /dev/null; then
    echo "📦 Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    source ~/.bashrc
fi

# Create virtual environment and install dependencies
echo "🔧 Creating virtual environment..."
uv sync

# Create symlinks
echo "🔗 Creating symlinks..."
sudo ln -sf $PWD/vimana.py /usr/bin/vimana
sudo ln -sf $PWD/vimana.py /usr/bin/vf

# Activate virtual environment
echo "🔧 Activating virtual environment..."
source .venv/bin/activate

# Set custom prompt to show we're in Vimana environment
export PS1="(vimana-framework) ⚡ "

# Test the setup with suppressed warnings
echo "🧪 Testing setup..."
echo "Testing: Loading/Listing plugins..."

# Suppress Python warnings during setup for clean output
export PYTHONWARNINGS="ignore::SyntaxWarning,ignore::DeprecationWarning,ignore::PendingDeprecationWarning"

# Re-activate environment (in case vimana affects it)
source .venv/bin/activate
export PS1="(vimana-framework) ⚡ "

# Load plugins (non-interactive)
vimana load --plugins

# Re-activate environment after vimana command
source .venv/bin/activate
export PS1="(vimana-framework) ⚡ "

# List plugins to verify
vimana list --plugins

# Re-activate environment one final time
source .venv/bin/activate
export PS1="(vimana-framework) ⚡ "

# Unset warning suppression for normal usage
unset PYTHONWARNINGS

echo ""
echo "🎊 Vimana Framework Setup completed successfully!"
echo "💡 Run 'vimana' or 'vf' to start the framework"
echo "🌐 Virtual environment: $PWD/.venv (in project directory)"
echo "💡 Use 'uv run vf' to run with proper environment"





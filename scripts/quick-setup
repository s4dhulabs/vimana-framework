#!/bin/bash
#  __ _
#   \/imana 2016
#   [|-ramewørk
#
# Quick setup script for Vimana Framework
# Usage: curl -s https://raw.githubusercontent.com/s4dhulabs/vimana-framework/develop/scripts/quick-setup | bash

echo "⚡ Vimana Framework Quick Setup"

# Check if we're already in a vimana-framework directory
if [[ "${PWD##*/}" == "vimana-framework" ]]; then
    echo "📁 Already in vimana-framework directory, running setup..."
    source scripts/setup-uv
else
    echo "📦 Cloning Vimana Framework..."
    git clone -b develop https://github.com/s4dhulabs/vimana-framework.git
    cd vimana-framework
    echo "🔧 Setting up Vimana..."
    source scripts/setup-uv
fi

echo "✨ Quick setup complete!" 